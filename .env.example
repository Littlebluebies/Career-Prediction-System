# =============================================================
# .env.example — template only. NO real secrets here.
# Copy to .env and change the values:  cp .env.example .env
# Sources: ENVIRONMENT_SETUP.md §14-15, §24-25; TECH_STACK.md §33-34;
#          DATABASE.md §57; docs/decisions/0006-dataset-metadata.md
# =============================================================

# --- General ---
NODE_ENV=development

# --- Ports (ENVIRONMENT_SETUP §24-25) ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
AI_SERVICE_PORT=8000
POSTGRES_PORT=5432

# --- PostgreSQL container (DATABASE.md §57) ---
POSTGRES_DB=career_system
POSTGRES_USER=career_user
POSTGRES_PASSWORD=change_me

# --- Connections ---
# Inside Docker, use service names, never localhost (ENVIRONMENT_SETUP §26-27)
DATABASE_URL=postgresql://career_user:change_me@postgres:5432/career_system
# Local development (backend running outside Docker) uses instead:
# DATABASE_URL=postgresql://career_user:change_me@localhost:5432/career_system
AI_SERVICE_URL=http://ai-service:8000

# Public: the only kind of variable the browser may see (ENVIRONMENT_SETUP §16)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# --- Application ---
SESSION_TTL_MINUTES=60
MAX_RESUME_SIZE_MB=10
ALGORITHM_VERSION=career-matching-v1
# "development" is the placeholder until a real dataset version exists (ADR 0006 §6)
DATASET_VERSION=development
